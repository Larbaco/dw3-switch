+                            /* wait for target field mode; keep force_once */
+                        } else if (dw3_host_menu_force_once()) {
                             fprintf(stderr,
-                                    "dw3: DW3_FORCE_NPC_ACTION applyAction code=0x%lx value=%ld\n",

+    sprite.draw(DW3_WIDE_PERIODIC(FILE_CACHE.getEntry(CNTY_SEL_SPRITES), SPRITE_BACKGROUND, offset, offset,
+                                  CNTY_SEL_BACKGROUND_PERIOD, 0),

Upstream-bound: no
Subject: [PORT_HOST] P6.1 menu backgrounds fill the gutters

The field menu, item shop, memory card and partner name screens draw a
scrolling pattern that repeats every 96 pixels. With a widescreen gutter
it is drawn twice more, 96 pixels to each side, so it covers the gutters
at every scroll. Off, nothing changes.

--- a/src/menus/field_menu/menu.c
+++ b/src/menus/field_menu/menu.c
@@ -2,6 +2,9 @@
    the files it loads; and the panels' openings and moves */
 
 #include "menus/field_menu.h"
+#if PORT_HOST
+#include "port_widescreen.h"
+#endif
 
 #include "shared/set_scroll_bar_x.inc.c"
 #include "shared/set_scroll_bar_range.inc.c"
@@ -52,6 +55,14 @@ void STSTATUS_drawBackground(FieldMenuScreen *menu) {
         menu->bgTick = 1;
     }
     sprite.draw(FILE_CACHE.getEntry(FILE_STATUS_SPRITES << 16), 0x1D, menu->bgScroll, menu->bgScroll);
+#if PORT_HOST
+    /* Widescreen: the pattern repeats every 96 pixels; two more copies
+       cover the side gutters at every scroll */
+    if (dw3_port_widescreen_px() > 0) {
+        sprite.draw(FILE_CACHE.getEntry(FILE_STATUS_SPRITES << 16), 0x1D, menu->bgScroll - 96, menu->bgScroll);
+        sprite.draw(FILE_CACHE.getEntry(FILE_STATUS_SPRITES << 16), 0x1D, menu->bgScroll + 96, menu->bgScroll);
+    }
+#endif
 }
 

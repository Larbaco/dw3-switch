+#if PORT_HOST
+/* P6.34 phase 1 (patch 0188): equipment chosen in the Items menu is put on the
+   chosen member through STSTATUS_equip, the only writer of the equipment. */
+static s32 portRefusalShown;
+
+static s32 portIsEquipment(s32 item) {
+    return dw3_port_items_equip_enabled() &&
+           (ITEM_FUNCS.isKind(item, ITEM_KIND_WEAPON) || ITEM_FUNCS.isKind(item, ITEM_KIND_ARMOR) ||
+            ITEM_FUNCS.isKind(item, ITEM_KIND_ACCESSORY));
+}
+
+static char *portItemName(s32 id) {
+    TextTools cls;
+
+    initTextTools(&cls);
+    return cls.getString(FILE_CACHE.load(TEXT_FILE(TEXT_ITEM_NAMES)), id);
+}
+
+/* The slot the chosen item goes to on the chosen member, or -1 after saying
+   why not (a line in the help window and in the log) */
+static s32 portEquipCheck(ItemScreen *screen, ItemScreenWindows *windows, const char **rule) {
+    s32 partner = GAME.funcs.getPartyMember(screen->member);
+    PartnerStats *stats = GAME.funcs.getPartnerStats(partner);
+    s32 item = screen->item;
+    ItemData *data = ITEM_FUNCS.get(item)->data.record;
+    const char *why = NULL;
+    char msg[96];
+    int worn[6];
+    int group[6];
+    s32 slot;
+    s32 i;
+
+    for (i = 0; i < 6; i++) {
+        worn[i] = stats->equip[i];
+        group[i] = worn[i] != 0 ? ITEM_FUNCS.get(worn[i])->data.record->weapon.group : -1;
+    }
+    slot = dw3_port_items_equip_slot(data->weapon.kind, data->weapon.group, worn, group, rule);
+    if (slot < 0) {
+        why = "unmapped-kind";
+    } else if (GAME.items[item] <= 0) {
+        why = "not-in-bag";
+    } else if (!STSTATUS_data.funcs.canEquip(partner, slot, item)) {
+        why = "partner-mask";
+    }
+    if (why != NULL) {
+        dw3_port_items_equip_refused(partner, item, why);
+        dw3_port_items_equip_message(msg, sizeof(msg), DW3_ITEMS_LANGUAGE, DW3_ITEMS_MSG_REFUSED, (char *)stats,
+                                     NULL, NULL);
+        windows->help->setString(windows->help, msg, -1);
+        SOUND.playSound(SOUND_CURSOR);
+        portRefusalShown = 1;
+        return -1;
+    }
+    dw3_port_items_equip_chosen(slot, *rule, worn[slot], slot == 2 && data->weapon.kind == EQUIP_KIND_BOTH_HANDS ? worn[3] : 0);
+    return slot;
+}
+
+/* Equips and says what was worn and what went back to the bag */
+static void portEquipApply(ItemScreen *screen, ItemScreenWindows *windows, s32 slot) {
+    s32 partner = GAME.funcs.getPartyMember(screen->member);
+    PartnerStats *stats = GAME.funcs.getPartnerStats(partner);
+    s32 item = screen->item;
+    s32 before[6];
+    s32 returned = 0;
+    char msg[160];
+    s32 i;
+
+    for (i = 0; i < 6; i++) {
+        before[i] = stats->equip[i];
+    }
+    dw3_port_items_equip_begin();
+    STSTATUS_data.funcs.equip(partner, slot, item);
+    dw3_port_items_equip_done(partner, slot, item);
+    for (i = 0; i < 6; i++) {
+        if (before[i] != 0 && before[i] != stats->equip[i] && returned == 0) {
+            returned = before[i];
+        }
+    }
+    dw3_port_items_equip_message(msg, sizeof(msg), DW3_ITEMS_LANGUAGE, DW3_ITEMS_MSG_DONE, portItemName(item),
+                                 (char *)stats, returned != 0 ? portItemName(returned) : NULL);
+    windows->help->setString(windows->help, msg, -1);
+    STSTATUS_showItemPage(screen, windows, screen->member, 1);
+    SOUND.playSound(SOUND_SELECT);
+    portRefusalShown = 0;
+}
+#endif

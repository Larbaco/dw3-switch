+        src = (u8 *)"SCPH1001  ";
+#else
         src = (u8 *)0x1FC0012C;
+#endif
         for (i = 0; i < 10; i++, src++) {
             /* the match depends on the breaks out of a do/while (0): loop.c
                moves the letter's and the dash's blocks up after the digit's,
@@ -1108,6 +1116,16 @@ void STAGSLCT_updateStageSelect(Task *task, StageSelectWindows *win) {
         }
         break;
     case TASK_KILL:
+#if PORT_HOST
+        /* P3.8: DW3_FORCE_STAGE already requested the target mode from
+           updateModeTask; do not let the cursor entry overwrite it (entry 0
+           is MODE_STAGE_SELECT). */
+        if (getenv("DW3_FORCE_STAGE") != NULL && getenv("DW3_FORCE_STAGE")[0] != '\0') {
+            GAME.stageSelectTop = sel->top;
+            GAME.stageSelectCursor = sel->cursor;
+            break;

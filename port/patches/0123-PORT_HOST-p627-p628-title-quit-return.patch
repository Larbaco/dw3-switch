+   the panel's own colours and redraws them 14 pixels lower. It is submitted
+   before the panel sprite, so the ordering table draws it after the sprite,
+   in front of it. Colours and lines are those of the sprite (the divider
+   under a row is 41,41,115, the border 82,82,165 and its shadow 0,0,8). */
+static void drawFieldMenuPanelRow(s32 layerId, s32 depth) {
+    Layer *layer = GFX.funcs.getLayer(layerId);
+    u_long *ot = layer->getOtEntry(layer, depth);
+    PrimPtr prim;
+    TILE *tile;
+    s32 x0 = DW3_MENU_RIGHT(0xA8);
+    s32 x1 = DW3_MENU_RIGHT(0x140);
+
+    prim.any = GFX.funcs.getPrim();
+    tile = (TILE *)prim.any;
+    /* body, rows 6 and 7 of the panel (the divider of row 6 stays) */
+    setTile(tile);
+    setRGB0(tile, 0, 0, 33);
+    setXY0(tile, x0 + 1, 132);
+    setWH(tile, x1 - x0 - 1, 17);
+    addPrim(ot, tile);
+    tile++;
+    /* the left border, straight down to the new bottom edge */
+    setTile(tile);
+    setRGB0(tile, 107, 107, 214);
+    setXY0(tile, x0, 132);
+    setWH(tile, 1, 18);
+    addPrim(ot, tile);
+    tile++;
+    /* the divider under the seventh row's predecessor (row 6) */
+    setTile(tile);
+    setRGB0(tile, 41, 41, 115);
+    setXY0(tile, x0 + 3, 145);
+    setWH(tile, x1 - x0 - 3, 1);
+    addPrim(ot, tile);
+    tile++;
+    /* the bottom border and its shadow */
+    setTile(tile);
+    setRGB0(tile, 82, 82, 165);
+    setXY0(tile, x0 + 2, 149);
+    setWH(tile, x1 - x0 - 2, 1);
+    addPrim(ot, tile);
+    tile++;
+    setTile(tile);
+    setRGB0(tile, 0, 0, 8);
+    setXY0(tile, x0 + 3, 150);
+    setWH(tile, x1 - x0 - 3, 2);
+    addPrim(ot, tile);
+    tile++;
+    GFX.funcs.setPrim(tile);
+}
+#endif

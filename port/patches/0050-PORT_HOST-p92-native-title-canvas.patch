+        dw3_port_title_options_draw(task->layerId, 78,
+            DW3_TITLE_ROW_Y(DW3_TITLE_PORT_OPTIONS), -2);
+    } else if (task->showOptions && task->state == TASK_DONE) {
+        dw3_port_title_options_draw(task->layerId, 78,
+            DW3_TITLE_ROW_Y(DW3_TITLE_PORT_OPTIONS), task->selection);

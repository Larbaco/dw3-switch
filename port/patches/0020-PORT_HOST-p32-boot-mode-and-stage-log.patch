     GAME.nextMode = MODE_COUNTRY_SELECT;
 #endif
+#if PORT_HOST
+    {
+        const char *start = getenv("DW3_START_MODE");
+        char *end = NULL;
+        long mode;
+
+        if (start != NULL && start[0] != '\0') {
+            mode = strtol(start, &end, 0);
+            if (end != start && mode > 0) {
+                GAME.mode = (s32)mode;

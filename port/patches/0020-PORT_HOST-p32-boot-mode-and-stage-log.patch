     case 1:
+#if PORT_HOST
+        {
+            const char *door = getenv("DW3_AUTO_DOOR_MODE");
+            const char *frames_env = getenv("DW3_AUTO_DOOR_FRAMES");
+            static s32 door_frames;
+            long door_mode;
+            long need_frames = 90;
+            char *end = NULL;

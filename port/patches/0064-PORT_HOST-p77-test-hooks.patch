+    {
+        /* P7.7: DW3_LANGUAGE=<0-6> (CNTY_SEL_languages: 2 English, 3 French,
+         * 5 German, 4 Italian, 6 Spanish) picks the text language of a run
+         * that boots past the country select, before initNewGameData copies
+         * the partners' names, so a replay can look at each language's text. */
+        const char *lang = getenv("DW3_LANGUAGE");
+
+        if (lang != NULL && lang[0] != '\0') {
+            char *end = NULL;
+            long n = strtol(lang, &end, 0);
+
+            if (end != lang && n >= 0 && n <= 6) {
+                LANGUAGE = (s32)n;
+                fprintf(stderr, "dw3: LANGUAGE=%ld (DW3_LANGUAGE)\n", n);
+            }
+        }
+    }
+#endif
 #endif

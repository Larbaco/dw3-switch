+                MEMCARD_FUNCS.setFileName();
+#if VERSION_US
+                if (dw3_autosave_load(autosave, GAME_SAVE_SIZE, 1) == 0) {
+#else
+                if (dw3_autosave_load(autosave, GAME_SAVE_SIZE, 2) == 0) {

 extern int dw3_port_title_logo_capture(const s32 *sheet);
@@ -40,6 +41,32 @@
             MEMCARD_FUNCS.setFileName();
             GAME.funcs.requestMode(MODE_CONTINUE, 0);
             break;
+#if PORT_HOST
+        case 4:
+            /* P6.31: Continue with an auto-save file loads it, as a Continue
+               of a slot would: a new game's state, then the saved bytes,
+               then the saved field mode. A file that cannot be read after
+               all falls back to the slot list. */
+            {
+                static u8 autosave[GAME_SAVE_SIZE];
+
+                left = 1;
+                GAME.funcs.newGame();

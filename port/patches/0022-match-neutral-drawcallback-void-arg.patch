     /* 0x00 */ s32 priority;
     /* 0x04 */ s32 param;
-    /* 0x08 */ void (*func)(s32 arg, void *layer, s32 param);
-    /* 0x0C */ s32 arg;
+    /* 0x08 */ void (*func)(void *arg, void *layer, s32 param);
+    /* 0x0C */ void *arg;
     /* 0x10 */ struct DrawCallback *next;
 };
 

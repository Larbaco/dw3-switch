Upstream-bound: no
Subject: [PORT_HOST] CD_READER.read via port/cdfs (sync)

FILE_CACHE.load uses CD_READER.read; on host, complete the read from the
packed runtime tree through cdfs_read instead of libcd sector streaming.
STR movies stay on PSY-Z libcd (P3.7). Title boot always uses offset 0 /
full file.

--- a/src/engine/file/cd_reader.c
+++ b/src/engine/file/cd_reader.c
@@ -2,6 +2,9 @@
 #include <libgs.h>
 #include <libetc.h>
 #include <libsnd.h>
+#if PORT_HOST
+#include "cdfs.h"
+#endif
 
 /* -G8 unit: small variables defined here are reached through $gp */
 static u_char CD_MODE[8];
@@ -108,6 +111,46 @@
 
 /* Starts reading `size` sectors (0: all) of a file into buffer; ignored while busy */
 void readFile(s32 file, s32 offset, s32 size, void *buffer, s32 *done) {
+#if PORT_HOST
+    s32 sectorCount;
+    size_t want;
+    uint32_t fileSize;
+    int n;
+
+    if (isCdReading() != 0) {
+        return;
+    }
+    CD_READER.file = file;
+    CD_READER.offset = offset;
+    CD_READER.buffer = buffer;
+    CD_READER.done = done;
+    if (done != NULL) {
+        *done = 0;
+    }
+    if (size == 0) {
+        sectorCount = FILE_TABLE.getSectorCount(file);
+    } else {
+        sectorCount = size;
+    }
+    CD_READER.sectorCount = sectorCount;
+    CD_READER.state = CD_READ_IDLE;
+    if (buffer == NULL || sectorCount <= 0 || offset != 0) {
+        return;
+    }
+    want = (size_t)sectorCount * (size_t)CD_SECTOR_SIZE;
+    HEAP.zero(buffer, (s32)want);
+    fileSize = cdfs_file_size((uint32_t)file);
+    if (fileSize == (uint32_t)-1 || want < (size_t)fileSize) {
+        return;
+    }
+    n = cdfs_read((uint32_t)file, buffer, want);
+    if (n < 0) {
+        return;
+    }
+    if (done != NULL) {
+        *done = 1;
+    }
+#else
     if (isCdReading() == 0) {
         CD_READER.file = file;
         CD_READER.offset = offset;
@@ -125,4 +168,5 @@
         CD_READER.sector = FILE_TABLE.getSector(file) + offset;
         startCdRead();
     }
+#endif
 }

+#if PORT_HOST
+/* Widescreen iris (patch 0115): the cover's grid cropped to the columns
+   xa <= x < xb of `layer` (which may reach into the side gutters), over an
+   opaque black quad of the same columns, so that it also hides what the layer
+   draws there (the map outside the iris' view). Both go to the layer's entry 0,
+   the grid first and the quad last, so the quad is drawn first. */
+void FIELDSTG_drawCoverSpan(Layer *layer, s32 xa, s32 xb, s32 level) {
+    PrimPtr prim;
+    u_long *ot;
+    s32 shade;
+    s32 x;
+    s32 y;
+    s32 i;
+    s32 sx;
+    s32 sy;
+    s32 x0;
+    s32 x1;
+    POLY_F4 *quad;
+
+    if (xb <= xa) {
+        return;
+    }
+    ot = (u_long *)layer->getOtEntry(layer, 0);
+    shade = level >> 8;
+    prim.any = GFX.funcs.getPrim();
+    for (y = 0; y < SCREEN_HEIGHT; y += 0x80) {
+        for (x = -0xC0; x < SCREEN_WIDTH + 0x80; x += 0x80) {
+            for (i = 0; i < 4; i++) {
+                sx = x + ((i & 1) << 6);
+                sy = y + ((i << 5) & 0x40);
+                x0 = sx < xa ? xa : sx;
+                x1 = sx + 0x40 > xb ? xb : sx + 0x40;
+                if (x1 <= x0) {
+                    continue;
+                }
+                SetSprt(prim.sprt);
+                if (shade != 0xFF) {
+                    SetSemiTrans(prim.sprt, 1);
+                }
+                prim.sprt->r0 = prim.sprt->g0 = prim.sprt->b0 = shade;
+                prim.sprt->x0 = x0;
+                prim.sprt->y0 = sy;
+                prim.sprt->u0 = FIELDSTG_state.images.field->u + (x0 - sx);
+                prim.sprt->v0 = FIELDSTG_state.images.field->v;
+                prim.sprt->w = x1 - x0;
+                prim.sprt->h = 0x40;
+                prim.sprt->clut = GetClut(FIELDSTG_state.images.field->clutX, FIELDSTG_state.images.field->clutY);
+                addPrim(ot, prim.any);
+                prim.sprt++;
+                SetDrawTPage(prim.tpage, 0, 1,
+                             GetTPage(0, 1, FIELDSTG_state.images.field->x, FIELDSTG_state.images.field->y));
+                addPrim(ot, prim.any);
+                prim.tpage++;
+            }
+        }
+    }
+    quad = (POLY_F4 *)prim.any;
+    setPolyF4(quad);
+    setRGB0(quad, 0, 0, 0);
+    quad->x0 = quad->x2 = xa;
+    quad->x1 = quad->x3 = xb;
+    quad->y0 = quad->y1 = 0;
+    quad->y2 = quad->y3 = SCREEN_HEIGHT;
+    addPrim(ot, quad);
+    GFX.funcs.setPrim(quad + 1);
+}
+#endif

 }
 
+#if PORT_HOST
+/* Patch 0146: the new full-screen map screen (P6.32). Square opens it over this
+   screen, which stays as it is (frozen: no pad, no area lookup, still drawn).
+   Returns 1 while the new screen has the pad. The reveal layer is what
+   STSTATUS_drawMapScreen draws over the dark map: the towns of the list for
+   GAME.progress (archive1 cells, texture 0x380,0x100) and the visited area
+   cells (archive2, texture 0x300,0x100); they go to the host as 4 s32 each
+   (kind 1 / 2, frame, x, y in map space, as the draw passes them before the
+   scroll and the top).
+   While the new screen is open the pad moves ITS cursor (the pad and the
+   left stick, over the whole map); the game's cursor is set to it every frame
+   (cursorX/Y = where it is on the 320x240 menu picture, the scroll so that
+   cursor - scroll is its map position) and the game's own area lookup and name
+   window run on it, so the name box, the sound and the text are the game's.
+   The game's cursor and scroll are put back when the new screen closes. */
+static s32 mapViewFrame(StatusMapScreen *screen, TextWindow **windows) {
+    static StatusMapScreen *savedFor;
+    static s32 saved[4];
+    Dw3MapViewIo io;
+    s32 active;
+    s32 spotX[47];
+    s32 spotY[47];
+    s32 pieces[4 * 80];
+    s32 *towns;
+    s32 npieces = 0;
+    unsigned held = 0;
+    unsigned pressed = 0;
+    s32 i;
+
+    for (i = 0; i < 47; i++) {
+        spotX[i] = STSTATUS_data.spots[i].x;
+        spotY[i] = STSTATUS_data.spots[i].y;
+    }
+    for (i = 0; i < 16; i++) {
+        held |= (unsigned)(PAD_HELD(i) & 1) << i;
+        pressed |= (unsigned)(PAD_PRESSED(i) & 1) << i;
+    }
+    towns = STSTATUS_data.funcs.getList(screen->gameHalf, screen->progress);
+    for (i = 0; towns[i] != 0 && npieces < 24; i++) {
+        pieces[npieces * 4 + 0] = 1;
+        pieces[npieces * 4 + 1] = towns[i] - 1;
+        pieces[npieces * 4 + 2] = STSTATUS_data.towns[towns[i]].x;
+        pieces[npieces * 4 + 3] = STSTATUS_data.towns[towns[i]].y;
+        npieces++;
+    }
+    for (i = 1; i < 47; i++) {
+        if (screen->visited[i - 1]) {
+            pieces[npieces * 4 + 0] = 2;
+            pieces[npieces * 4 + 1] = STSTATUS_data.spots[i].sprite;
+            pieces[npieces * 4 + 2] = STSTATUS_data.spots[i].x;
+            pieces[npieces * 4 + 3] = STSTATUS_data.spots[i].y;
+            npieces++;
+        }
+    }
+    io.cursor_anim = STSTATUS_cursorFrames[screen->cursorFrame];
+    io.home_anim = screen->homeFrame;
+    io.name_x0 = io.name_y0 = io.name_x1 = io.name_y1 = 0;
+    dw3_port_sprite_frame_bounds(FILE_CACHE.getEntry(FILE_STATUS_SPRITES << 16), 0x3B, &io.name_x0, &io.name_y0,
+                                 &io.name_x1, &io.name_y1);
+    io.cur_x = io.cur_y = io.scr_x = io.scr_y = 0;
+    io.game_cx = screen->cursorX;
+    io.game_cy = screen->cursorY;
+    io.game_sx = screen->scrollX;
+    io.game_sy = screen->scrollY;
+    active = dw3_port_map_view_frame(FILE_CACHE.getEntry(screen->archive), screen->file, screen->gameHalf,
+                                     screen->homeX, screen->homeY, screen->visited, spotX, spotY, held, pressed,
+                                     FILE_CACHE.getEntry(screen->archive1), FILE_CACHE.getEntry(screen->archive2),
+                                     pieces, npieces, &io);
+    if (active) {
+        if (savedFor != screen) {
+            savedFor = screen;
+            saved[0] = screen->cursorX;
+            saved[1] = screen->cursorY;
+            saved[2] = screen->scrollX;
+            saved[3] = screen->scrollY;
+        }
+        screen->cursorX = io.scr_x;
+        screen->cursorY = io.scr_y;
+        screen->scrollX = io.scr_x - io.cur_x;
+        screen->scrollY = io.scr_y - io.cur_y;
+        STSTATUS_showMapArea(screen, windows);
+    } else if (savedFor == screen) {
+        screen->cursorX = saved[0];
+        screen->cursorY = saved[1];
+        screen->scrollX = saved[2];
+        screen->scrollY = saved[3];
+        savedFor = 0;
+    }
+    return active;
+}
+#endif
+
 /* The map screen's update */
 void STSTATUS_updateMapScreen(StatusMapScreen *screen, TextWindow **windows) {
     s32 area;
@@ -386,6 +477,12 @@
         }
         break;
     case TASK_RUN:
+#if PORT_HOST
+        if (mapViewFrame(screen, windows)) {
+            STSTATUS_drawMapScreen(screen);
+            break;
+        }
+#endif
         STSTATUS_runMapScreen(screen, windows);
         STSTATUS_showMapArea(screen, windows);
         STSTATUS_drawMapScreen(screen);

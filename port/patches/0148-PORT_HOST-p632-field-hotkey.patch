+#if PORT_HOST
+/* Patch 0148 (P6.32 phase 6): the full-screen map straight from the walking field. The key
+   (map_view_field_open, default Select, a PS button after the P6.12 / P9.8 map) goes down in
+   the field's main state, next to the Start check. The field is held with the engine's own
+   task pause (Task.paused: a task in TASK_RUN that is paused skips its update and its
+   children), the game's Map screen is created in the field menu's slot (children->menu: the
+   field task waits in substate 1 until it is NULL, as for the Start menu) under a small root
+   (STSTATUS_createFieldMapRoot), and the view opens on it by itself. When the screen goes
+   the field task is back in substate 1: the children run again and the port gives back the
+   clocks, the roll sequence and the VRAM the Map screen used. Policy and logs:
+   port/map_view/map_view.c. Nothing here runs unless the key goes down. */
+Task *STSTATUS_createFieldMapRoot(void);
+
+static void portFieldMapProbe(FieldTask *task, FieldChildren *children, Dw3FieldMapProbe *probe) {
+    Task **kids = (Task **)task->children;
+    s32 i;
+
+    probe->menu_open = FIELDSTG_state.menuOpen;
+    probe->busy = FIELDSTG_state.busy;
+    probe->acting = FIELDSTG_state.acting;
+    probe->progress = GAME.progress;
+    probe->battle_steps = GAME.battleSteps;
+    probe->player_x = children->actors[0] != NULL ? children->actors[0]->pos.x : 0;
+    probe->player_y = children->actors[0] != NULL ? children->actors[0]->pos.y : 0;
+    probe->children = 0;
+    probe->held = 0;
+    probe->running = 0;
+    for (i = 0; i < task->childCount; i++) {
+        if (kids[i] != NULL) {
+            probe->children++;
+            if (kids[i]->paused != 0) {
+                probe->held++;
+            }
+            if (kids[i]->state == TASK_RUN) {
+                probe->running++;
+            }
+        }
+    }
+}
+
+static void portFieldMap(FieldTask *task, FieldChildren *children) {
+    Dw3FieldMapProbe probe;
+    Task **kids = (Task **)task->children;
+    unsigned held = 0;
+    unsigned pressed = 0;
+    s32 i;
+
+    for (i = 0; i < 16; i++) {
+        held |= (unsigned)(PAD_HELD(i) & 1) << i;
+        pressed |= (unsigned)(PAD_PRESSED(i) & 1) << i;
+    }
+    portFieldMapProbe(task, children, &probe);
+    if (!dw3_port_map_view_field_poll(held, pressed, &probe)) {
+        return;
+    }
+    if (!dw3_port_map_view_field_begin(&probe)) {
+        return;
+    }
+    FIELDSTG_state.menuOpen = 1;
+    FIELDSTG_state.busy = 1;
+    for (i = 0; i < task->childCount; i++) {
+        if (kids[i] != NULL) {
+            kids[i]->paused = 1;
+        }
+    }
+    children->menu = (FieldMenu *)STSTATUS_createFieldMapRoot();
+    task->nextSubstate(task);
+}
+
+static void portFieldMapResume(FieldTask *task, FieldChildren *children) {
+    Dw3FieldMapProbe probe;
+    Task **kids = (Task **)task->children;
+    s32 i;
+
+    if (!dw3_port_map_view_field_active()) {
+        return;
+    }
+    for (i = 0; i < task->childCount; i++) {
+        if (kids[i] != NULL) {
+            kids[i]->paused = 0;
+        }
+    }
+    portFieldMapProbe(task, children, &probe);
+    probe.held = probe.running;
+    dw3_port_map_view_field_end(&probe);
+}
+#endif

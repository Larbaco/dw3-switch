+#if PORT_HOST
+/* Patch 0148 (P6.32 phase 6): the root of a Map screen that opens from the walking field. The
+   status mode's own main task (STSTATUS_updateMenu) loads the menu's strings and shows the
+   field menu again when the screen ends; here only what the Map screen needs is loaded (its
+   sprite sheets and images, and the status sprites the name box frame comes from), the screen
+   is created, and the root ends with it. The images go to the same VRAM places as the
+   status mode puts them (the port gives the field's VRAM back at the close). */
+static void fieldMapRootUpdate(Task *task, Task **children) {
+    TimLoader loader;
+    s32 half;
+
+    switch (task->state) {
+    case TASK_INIT:
+    default:
+        switch (task->substate) {
+        case 0:
+        default:
+            half = STSTATUS_areaFuncs.getGameHalf();
+            task->key1 = half;
+            FILE_CACHE.request(FILE_STATUS_SPRITES);
+            FILE_CACHE.request(FILE_STATUS_SPRITES + 1);
+            FILE_CACHE.request(FILE_STATUS_BG + 2 * half);
+            FILE_CACHE.request(FILE_STATUS_BG + 1 + 2 * half);
+            task->nextSubstate(task);
+            break;
+        case 1:
+            half = task->key1;
+            if (task->counter++ > 600) {
+                /* the files did not come: give the field back rather than hold it for ever */
+                fprintf(stderr, "dw3-map: field hotkey: the Map screen's files did not load in 600 frames; "
+                        "back to the field\n");
+                task->setState(task, TASK_KILL);
+                break;
+            }
+            if (FILE_CACHE.isLoading(FILE_STATUS_SPRITES) != 0 || FILE_CACHE.isLoading(FILE_STATUS_SPRITES + 1) != 0 ||
+                FILE_CACHE.isLoading(FILE_STATUS_BG + 2 * half) != 0 ||
+                FILE_CACHE.isLoading(FILE_STATUS_BG + 1 + 2 * half) != 0) {
+                break;
+            }
+            initTimLoader(&loader);
+            loader.setImagePos(0x280, 0x100);
+            loader.loadArchive(FILE_CACHE.getEntry((FILE_STATUS_SPRITES + 1) << 16));
+            loader.setImagePos(0x380, 0x100);
+            loader.loadArchive(FILE_CACHE.getEntry(((FILE_STATUS_BG + 1 + 2 * half) << 16) + 1));
+            loader.setImagePos(0x300, 0x100);
+            loader.loadArchive(FILE_CACHE.getEntry(((FILE_STATUS_BG + 1 + 2 * half) << 16) + 2));
+            loader.setImagePos(0x280, 0);
+            loader.setClutPos(0x140, 0x100);
+            loader.loadArchive(FILE_CACHE.getEntry((FILE_STATUS_BG + 1 + 2 * half) << 16));
+            children[0] = STSTATUS_createMapScreen(NULL, 0);
+            task->nextState(task);
+            break;
+        }
+        break;
+    case TASK_RUN:
+        if (children[0] == NULL) {
+            task->setState(task, TASK_KILL);
+        } else if (children[0]->state == TASK_INIT && task->counter++ > 600) {
+            fprintf(stderr, "dw3-map: field hotkey: the Map screen did not start in 600 frames; "
+                    "back to the field\n");
+            children[0]->setState(children[0], TASK_KILL);
+        }
+        break;
+    case TASK_DONE:
+    case TASK_KILL:
+        break;
+    }
+}
+
+Task *STSTATUS_createFieldMapRoot(void) {
+    return createTask(fieldMapRootUpdate, sizeof(Task), sizeof(Task *));
+}
+#endif

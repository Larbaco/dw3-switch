+            int first = 0;
+            int last = 0;
+            int count = 3;
+            int i;
+
+            if (sscanf(forced, "%d-%d:%d", &first, &last, &count) >= 2) {
+                if (first < 1) {
+                    first = 1;
+                }
+                if (last > 0x192) {
+                    last = 0x192;
+                }
+                if (count < 1 || count > 99) {
+                    count = 3;
+                }
+                for (i = first; i <= last; i++) {
+                    GAME.items[i] = count;
+                }
+                fprintf(stderr, "dw3: DW3_FORCE_ITEMS items %d..%d x%d\n", first, last, count);
+            }
+        }
+    }
+#endif
     return shop;
 }
 

+            const char *ret = getenv("DW3_AUTO_MENU_RETURN");
+            static s32 menu_frames;
+            static s32 menu_mode;
+            long need_frames = 180;
+            char *end = NULL;
+            s32 mode = GAME.funcs.getMode();
+            s32 overlay = MODE_OVERLAY(mode);
+
+            if (ret != NULL && ret[0] != '\0' &&

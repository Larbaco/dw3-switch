 void screenFadeStart(ScreenFade *task, s32 fadeIn, s32 duration) {
@@ -33,6 +36,11 @@ void drawScreenFade(ScreenFade *task) {
     poly->r0 = poly->g0 = poly->b0 = task->level >> 8;
     poly->x0 = poly->x2 = 0;
     poly->x1 = poly->x3 = SCREEN_WIDTH;
+#if PORT_HOST
+    /* Widescreen: the fade covers the side gutters too */
+    poly->x0 = poly->x2 = -dw3_port_widescreen_px();
+    poly->x1 = poly->x3 = SCREEN_WIDTH + dw3_port_widescreen_px();
+#endif
     poly->y0 = poly->y1 = 0;
     poly->y2 = poly->y3 = 256;
     addPrim(ot, poly);

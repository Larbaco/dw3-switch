Upstream-bound: no
Subject: [PORT_HOST] P6.1 full-screen fades cover the gutters

With widescreen on, the full-screen quads that fade, darken or flash the
screen reach across both side gutters instead of the middle 320 columns:
the screen fade (the inn night, script fades), the overlays' drawFader,
the stage darkness, the battle white flash, the field battle transition
shade and the field cover. Off, the gutter is 0 and they are unchanged.

--- a/src/battle/battle_mode/white_flash.c
+++ b/src/battle/battle_mode/white_flash.c
@@ -1,6 +1,9 @@
 /* FIGHTSTG's white flash over the screen. */
 
 #include "battle/battle_mode.h"
+#if PORT_HOST
+#include "port_widescreen.h"
+#endif
 
 /* Draws the white flash: a full-screen quad of the task's level, added to the
    screen on layer BATTLE_LAYER_FRONT */
@@ -18,6 +21,11 @@ void FIGHTSTG_drawWhiteFlash(WhiteFlash *task) {
     /* the match depends on these chained stores, x3 before x1 */
     poly->x3 = poly->x1 = 320;
     poly->x2 = poly->x0 = 0;
+#if PORT_HOST
+    /* Widescreen: the flash covers the side gutters too */
+    poly->x3 = poly->x1 = 320 + dw3_port_widescreen_px();
+    poly->x2 = poly->x0 = -dw3_port_widescreen_px();
+#endif
     poly->y1 = poly->y0 = 0;
     poly->y3 = poly->y2 = 240;
     addPrim(ot, poly);
--- a/src/engine/gfx/screen_fade.c
+++ b/src/engine/gfx/screen_fade.c
@@ -1,4 +1,7 @@

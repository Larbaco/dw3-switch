Upstream-bound: no
Subject: [PORT_HOST] P3.4 pad/NPC evidence + host CD partial reads

Fix CD_READER.read for offset/partial sector windows (map streamer).
DW3_FORCE_NPC_ACTION runs FLAGS_00.applyAction (0x7A/0x94/0x7C leaveField).

--- a/src/engine/file/cd_reader.c
+++ b/src/engine/file/cd_reader.c
@@ -134,16 +134,17 @@
     }
     CD_READER.sectorCount = sectorCount;
     CD_READER.state = CD_READ_IDLE;
-    if (buffer == NULL || sectorCount <= 0 || offset != 0) {
+    if (buffer == NULL || sectorCount <= 0) {
         return;
     }
     want = (size_t)sectorCount * (size_t)CD_SECTOR_SIZE;
-    HEAP.zero(buffer, (s32)want);
     fileSize = cdfs_file_size((uint32_t)file);
-    if (fileSize == (uint32_t)-1 || want < (size_t)fileSize) {
+    if (fileSize == (uint32_t)-1) {
         return;
     }
-    n = cdfs_read((uint32_t)file, buffer, want);
+    /* Partial and offset reads (map streamer / tiles) via cdfs_read_at. */
+    n = cdfs_read_at((uint32_t)file, buffer,
+                     (size_t)offset * (size_t)CD_SECTOR_SIZE, want);
     if (n < 0) {
         return;
     }

+#if PORT_HOST
+/* P6.34 phase 3: Square shows the next filter. The list is rebuilt, the cursor
+   goes to "none", the stat preview to the emptied slot, the scroll bar follows
+   the new count. Nothing is equipped. */
+static void portCycleFilter(EquipPanel *panel, EquipPanelWindows *windows) {
+    s32 i;
+    s32 worn;
+
+    portFilter = dw3_port_items_bag_next(portFilter);
+    worn = portBuildList(panel, portFilter);
+    panel->cursor = 0;
+    panel->scroll = 0;
+    if (windows->scrollBar != NULL) {
+        windows->scrollBar->state = 3;
+        windows->scrollBar = NULL;
+    }
+    for (i = 0; i < 8; i++) {
+        windows->rows[i].name->setVisible(windows->rows[i].name, 0);
+        windows->rows[i].times->setVisible(windows->rows[i].times, 0);
+        windows->rows[i].count->setVisible(windows->rows[i].count, 0);
+    }
+    STSTATUS_showEquipList(panel, windows, 1);
+    windows->listCursor->setPos(windows->listCursor, DW3_MENU_RIGHT(0x86), 0x4B);
+    panel->screen->previewStats(panel->screen, panel->slot, 0);
+    if (panel->count >= 9) {
+        windows->scrollBar = STSTATUS_createScrollBar();
+        windows->scrollBar->setX(windows->scrollBar, DW3_MENU_RIGHT(0x125), 0xC);
+        windows->scrollBar->setRange(windows->scrollBar, 0x4E, 0xB3);
+        windows->scrollBar->setCount(windows->scrollBar, 8, panel->count);
+        windows->scrollBar->setPos(windows->scrollBar, 0);
+    }
+    SOUND.playSound(SOUND_CURSOR);
+    dw3_port_items_bag_viewed(portFilter, panel->slot, panel->count - 1,
+                              portFilter == DW3_BAG_WORN ? worn : portCountWornElsewhere(panel));
+}
+#endif

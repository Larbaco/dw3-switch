+
+/* P6.34 phase 3 (patch 0191): Square in the item list cycles the filter (the
+   slot's items, all weapons, all armor and accessories, the items the other
+   party members wear). The list is rebuilt in panel->items; the rows of the
+   last filter also keep who wears the item and in which slot. */
+#if VERSION_EU
+#define DW3_BAG_LANGUAGE LANGUAGE
+#else
+#define DW3_BAG_LANGUAGE 2
+#endif
+static s32 portFilter;           /* DW3_BAG_SLOT .. DW3_BAG_WORN */
+static s16 portWearer[0x194];    /* per row of the worn filter: the partner id */
+static s8 portWearerSlot[0x194]; /* and its slot */
+
+static s32 portKindOf(s32 item) {
+    return ITEM_FUNCS.get(item)->data.record->weapon.kind;
+}
+
+/* The rows of the worn filter that hold `item` (the copies the others wear) */
+static s32 portWornCopies(EquipPanel *panel, s32 item) {
+    s32 n = 0;
+    s32 i;
+
+    for (i = 1; i < panel->count; i++) {
+        if (panel->items[i] == item) {
+            n++;
+        }
+    }
+    return n;
+}
+
+/* Whether the other party members' item (worn in `slot` of `stats`) is a row of the worn filter */
+static s32 portIsWornRow(EquipPanel *panel, PartnerStats *stats, s32 slot) {
+    s32 item = stats->equip[slot];
+
+    if (item <= 0 || !dw3_port_items_bag_fits(panel->slot, portKindOf(item)) ||
+        !STSTATUS_data.funcs.canEquip(panel->partner, panel->slot, item)) {
+        return 0;
+    }
+    /* a two-handed item is one row */
+    return !(slot == 3 && stats->equip[2] == item && portKindOf(item) == EQUIP_KIND_BOTH_HANDS);
+}
+
+/* Fills panel->items / count for a filter. Row 0 stays "none" (-1). Returns the
+   copies the other party members wear that fit the slot. */
+static s32 portBuildList(EquipPanel *panel, s32 filter) {
+    s32 n = 1;
+    s32 count;
+    s32 i;
+    s32 m;
+    s32 slot;
+    s32 p;
+    s32 fits;
+    PartnerStats *stats;
+
+    panel->items[0] = -1;
+    if (filter == DW3_BAG_WORN) {
+        for (m = 0; m < panel->screen->count; m++) {
+            p = GAME.funcs.getPartyMember(m);
+            if (p == panel->partner) {
+                continue;
+            }
+            stats = GAME.funcs.getPartnerStats(p);
+            for (slot = 0; slot < 6; slot++) {
+                if (portIsWornRow(panel, stats, slot)) {
+                    portWearer[n] = p;
+                    portWearerSlot[n] = slot;
+                    panel->items[n++] = stats->equip[slot];
+                }
+            }
+        }
+        panel->count = n;
+        return n - 1;
+    }
+    if (filter == DW3_BAG_WEAPONS) {
+        count = STSTATUS_data.funcs.listItems(2, panel->owned);
+    } else {
+        count = STSTATUS_data.funcs.listItems(3, panel->owned);
+        count += STSTATUS_data.funcs.listItems(4, panel->owned + count);
+    }
+    /* the ones that fit the slot first, as the original list does, then the rest */
+    for (fits = 1; fits >= 0; fits--) {
+        for (i = 0; i < count; i++) {
+            if ((STSTATUS_data.funcs.canEquip(panel->partner, panel->slot, panel->owned[i]) &&
+                 dw3_port_items_bag_fits(panel->slot, portKindOf(panel->owned[i]))) == fits) {
+                panel->items[n++] = panel->owned[i];
+            }
+        }
+    }
+    panel->count = count + 1;
+    return 0;
+}
+
+/* The copies the other party members wear that fit the slot, whatever filter is shown */
+static s32 portCountWornElsewhere(EquipPanel *panel) {
+    s32 total = 0;
+    s32 m;
+    s32 slot;
+    s32 p;
+    PartnerStats *stats;
+
+    for (m = 0; m < panel->screen->count; m++) {
+        p = GAME.funcs.getPartyMember(m);
+        if (p == panel->partner) {
+            continue;
+        }
+        stats = GAME.funcs.getPartnerStats(p);
+        for (slot = 0; slot < 6; slot++) {
+            total += portIsWornRow(panel, stats, slot);
+        }
+    }
+    return total;
+}
+
+/* The list title names the filter and the rows; the line under the help text
+   names the wearer of the chosen row of the worn filter */
+static void portShowFilterTitle(EquipPanel *panel, EquipPanelWindows *windows) {
+    char msg[96];
+
+    dw3_port_items_bag_title(msg, sizeof(msg), DW3_BAG_LANGUAGE, portFilter, panel->count - 1);
+    windows->listTitle->setString(windows->listTitle, msg, -1);
+}
+
+static void portShowWearer(EquipPanel *panel, EquipPanelWindows *windows) {
+    char msg[96];
+    s32 row = panel->cursor + panel->scroll;
+
+    if (portFilter != DW3_BAG_WORN || row <= 0 || row >= panel->count) {
+        return;
+    }
+    dw3_port_items_bag_note(msg, sizeof(msg), DW3_BAG_LANGUAGE,
+                            (char *)GAME.funcs.getPartnerStats(portWearer[row]));
+    windows->kind->setString(windows->kind, msg, -1);
+}
 #endif
 

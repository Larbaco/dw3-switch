--- a/src/engine/text/cursor.c	2026-10-10 03:06:46.445022200 -0300
+++ b/src/engine/text/cursor.c	2026-10-10 04:33:42.341824822 -0300
@@ -90,7 +90,7 @@
 
 /* A menu cursor on a layer at (x, y) */
 Cursor *createCursor(s16 layerId, s32 depth, s16 x, s16 y) {
-    Cursor *task = createTask(updateCursor, sizeof(Cursor), 4);
+    Cursor *task = createTask(updateCursor, sizeof(Cursor), sizeof(Task *));
 
     task->layerId = layerId;
     task->depth = depth;

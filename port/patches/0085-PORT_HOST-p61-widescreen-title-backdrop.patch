--- a/src/menus/title/edge_fade.c
+++ b/src/menus/title/edge_fade.c
@@ -1,6 +1,19 @@
 /* The fade out from the screen's edges once an option is chosen */
 
 #include "menus/title.h"
+#if PORT_HOST
+#include "port_widescreen.h"
+
+/* Widescreen (patch 0085): the triangles reach the picture's edges, so the
+   gutters darken with the rest */
+static s32 STDWTITL_edgeX(s32 x) {
+    s32 gutter = dw3_port_widescreen_px();
+
+    return x <= 0 ? x - gutter : x >= SCREEN_WIDTH ? x + gutter : x;
+}
+#else
+#define STDWTITL_edgeX(x) (x)
+#endif
 #if defined(DW3_TITLE_NATIVE_OVERLAY)
 extern void dw3_port_title_overlay_fade(s32 level);
 #endif

Upstream-bound: no
Subject: [PORT_HOST] P6.17 route music and sound-effect tracks to separate mixer buses

playSound is the one place that knows a SEP track is music: the exclusive
flag (bit 30) of its packed id. Tell the port which (SEQ, track) it starts
and whether it is music, so the SPU mixer can scale music and sound effects
separately. Key-on sounds (SsUtKeyOn) and non-exclusive tracks are sound
effects. Also poll the port once per frame (stats logging only; no game state
changes). With both volumes at the default the mix is unchanged.

--- a/src/engine/sound/sound.c
+++ b/src/engine/sound/sound.c
@@ -3,6 +3,7 @@
 
 #if PORT_HOST
 #include <stdio.h>
+#include "port_audio.h"
 #endif
 
 /* Each bank's files (SOUND_BANK_FILES[id]) */
@@ -262,6 +263,10 @@
                 }
             }
 #endif
+#if PORT_HOST
+            /* P6.17: tell the mixer whether this track is music (exclusive) */
+            dw3_port_audio_note_sequence(SOUND.banks[slot].seqs[seq], sep, exclusive);
+#endif
             id = sep;
             SsSepStop(SOUND.banks[slot].seqs[seq], id);
             SsSepSetVol(SOUND.banks[slot].seqs[seq], id, SOUND_VOLUME_MAX, SOUND_VOLUME_MAX);

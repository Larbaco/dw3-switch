--- a/src/battle/battle_mode/tech_menu.c
+++ b/src/battle/battle_mode/tech_menu.c
@@ -1,6 +1,11 @@
 /* FIGHTSTG's technique menu. */
 
 #include "battle/battle_mode.h"
+#if PORT_HOST
+#include "port_battle_menu.h"
+char *getenv(const char *name);
+long strtol(const char *nptr, char **endptr, int base);
+#endif
 
 /* Draws the page's technique icons, the page arrows (blinking) and the frame */
 void FIGHTSTG_drawTechMenu(TechMenu *task) {
@@ -276,8 +281,51 @@
         } else {
             listSlotTechs(task, fighter, member, id);
         }
+#if PORT_HOST
+        {
+            /* P7.9 test hook: DW3_EXTRA_TECHS=<id>,<id>,... adds those
+             * techniques to the partner's list (up to 12), so a replay can
+             * look at a list with several lines and a second page; the stock
+             * Kotemon starts with Hot Head only */
+            const char *extra = getenv("DW3_EXTRA_TECHS");
+
+            while (extra != NULL && extra[0] != '\0' && task->count < 12) {
+                char *end = NULL;
+                long id = strtol(extra, &end, 0);
+
+                if (end == extra) {
+                    break;
+                }
+                task->techs[task->count++] = (s32)id;
+                extra = end[0] == ',' ? end + 1 : end;
+            }
+        }
+#endif
         setTechPages(task);
         children[0].cursor = FIGHTSTG_createCursor(&FIGHTSTG_techCursor);
+#if PORT_HOST
+        {
+            /* P7.9: the cursor starts on the technique this partner used last
+             * (Off, or nothing remembered, or no longer in the list, or not
+             * enough MP for it: the first line, as in the original) */
+            s32 want = dw3_port_battle_menu_tech_wanted(member);
+            s32 k;
+
+            for (k = 0; want != 0 && k < task->count; k++) {
+                if ((task->techs[k] & SKILL_ID) == want) {
+                    if (fighter->temporary != 0 || fighter->mp >= FIGHTSTG_battleFuncs.getTechCost(0, task->techs[k])) {
+                        s32 lines = task->count - (k / TECH_MENU_LINES) * TECH_MENU_LINES;
+
+                        task->page = k / TECH_MENU_LINES;
+                        children[0].cursor->params.count = lines > TECH_MENU_LINES ? TECH_MENU_LINES : lines;
+                        children[0].cursor->sel = k % TECH_MENU_LINES;
+                        dw3_port_battle_menu_tech_applied(member, want, (int)task->page, (int)children[0].cursor->sel);
+                    }
+                    break;
+                }
+            }
+        }
+#endif
         FIGHTSTG_createTechWindows(task, children);
         FIGHTSTG_showTechPage(task, children);
         task->nextState(task);

Upstream-bound: no
Subject: [PORT_HOST] Field tiles copy one resident map

Drop the one-tile busy hold. readFile with done != NULL still calls
cdfs_read_field_tile, which keeps one map file in a host buffer.
isCdReading is idle when that call returns, so a second tile in the
same frame proceeds. vsyncCallback and FILE_CACHE.load no longer
call cdfs_poll.

--- a/src/engine/file/cd_reader.c
+++ b/src/engine/file/cd_reader.c
@@ -96,12 +96,6 @@ void cdSyncCallback(s32 status, u_char *result) {
 
 /* Whether the CD reader is busy */
 s32 isCdReading(void) {
-#if PORT_HOST
-    /* Field-tile fread is already done; the hold lasts until cdfs_poll. */
-    if (cdfs_field_tile_busy() != 0) {
-        return 1;
-    }
-#endif
     return CD_READER.state != CD_READ_IDLE;
 }
 
@@ -148,8 +142,8 @@ void readFile(s32 file, s32 offset, s32 size, void *buffer, s32 *done) {
     if (fileSize == (uint32_t)-1) {
         return;
     }
-    /* Map header and file cache stay on cdfs_read_at (no per-frame hold).
-       A field tile passes done and is paced to one read per cdfs_poll. */
+    /* Map header and file cache stay on cdfs_read_at.
+       A field tile (done != NULL) copies from the one resident map. */
     if (done != NULL) {
         n = cdfs_read_field_tile((uint32_t)file, buffer,
                                  (size_t)offset * (size_t)CD_SECTOR_SIZE, want);

+                         FIGHTSTG_action.effects[TECH_EFFECT_STEAL] != 0) {
+                    /* P7.7: the hit knocked the enemy out (step 1), which skips
+                     * the action's events, so a Picking / Snapping Claw whose
+                     * steal roll succeeded lost its item with no message.
+                     * Run the events with only the steal left, then end the

+                    fprintf(stderr, "dw3-p77: claw steal on a knocked-out enemy (tech %d)\n", (int)task->tech);
+                    children[0].events = FIGHTSTG_startActionEvents(task->side);
+                    task->setSubstate(task, 10);
+                    break;
+                }
+#endif

Upstream-bound: no

PORT_HOST: keep MemCard + MemCardFuncs in one MemCardSystem object so
MEMCARD_SYSTEM.funcs matches on LP64 (adjacent globals gain align gap;
writeInfo was calling setHeader and staying status==0).

--- a/include/engine/memcard.h	2026-10-10 05:05:46.602092200 -0300
+++ b/include/engine/memcard.h	2026-10-10 07:17:42.664063703 -0300
@@ -154,8 +154,19 @@
 long MemCardUnformat(long chan);
 long MemCardGetDirentry(long chan, char *name, CardDirEntry *dir, long *files, long ofs, long max);
 
+#if PORT_HOST
+/* Contiguous card+funcs so MEMCARD_SYSTEM cast matches (LP64 align gap). */
+typedef struct MemCardSystem {
+    MemCard card;
+    MemCardFuncs funcs;
+} MemCardSystem;
+extern MemCardSystem g_dw3_memcard;
+#define MEMCARD (g_dw3_memcard.card)
+#define MEMCARD_FUNCS (g_dw3_memcard.funcs)
+#else
 extern MemCard MEMCARD;
 extern MemCardFuncs MEMCARD_FUNCS;
+#endif
 extern s32 MEMCARD_SYNC_CMDS[]; /* the MemCardSync command of each MEMCARD_OP_* */
 extern char STR_ALL_FILES[]; /* the directory pattern that matches every file */
 

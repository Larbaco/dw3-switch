+/* Loads a tile's TIM into MAP_SPLIT_SLOT: its CLUT as usual, the left 64
+   units of its image at the slot and the rest 128 rows under it */
+static void loadSplitTile(StreamTask *task, void *tim) {
+    static u16 half[0x40 * 0x80];
+    TimCursor p;
+    RECT rect;
+    u16 *pixels;
+    s32 flag;
+    s32 side;
+    s32 row;
+    s32 col;
+    s32 w;
+
+    p.word = tim;
+    p.word++;
+    flag = *p.word++;
+    if (flag & 8) {
+        setRECT(&rect, task->clutX, task->clutY, p.block->w, p.block->h);
+        LoadImage(&rect, (u_long *)p.block->pixels);
+        p.byte += p.block->size;
+    }
+    pixels = (u16 *)p.block->pixels;
+    for (side = 0; side < 2; side++) {
+        w = p.block->w - side * 0x40;
+        w = w > 0x40 ? 0x40 : w;
+        if (w <= 0 || p.block->h > 0x80) {
+            break;
+        }
+        for (row = 0; row < p.block->h; row++) {
+            for (col = 0; col < w; col++) {
+                half[row * w + col] = pixels[row * p.block->w + side * 0x40 + col];
+            }
+        }
+        setRECT(&rect, task->imageX, task->imageY + side * 0x80, w, p.block->h);
+        LoadImage(&rect, (u_long *)half);
+        DrawSync(0);
+    }
+}
+
+/* Puts a sprite of the tile in MAP_SPLIT_SLOT on the right half's rows:
+   a sprite across the halves becomes two. Returns the next prim. */
+static SPRT *splitTileSprite(SPRT *sprt, s32 u, s32 v) {
+    s32 left;
+
+    if (u >= MAP_SPLIT_HALF) {
+        sprt->u0 = u - MAP_SPLIT_HALF;
+        sprt->v0 = v + MAP_SPLIT_HALF;
+        return sprt;
+    }
+    if (u + sprt->w <= MAP_SPLIT_HALF) {
+        return sprt;
+    }
+    left = MAP_SPLIT_HALF - u;
+    sprt[1] = sprt[0];
+    sprt->w = left;
+    sprt++;
+    sprt->x0 += left;
+    sprt->w -= left;
+    sprt->u0 = 0;
+    sprt->v0 = v + MAP_SPLIT_HALF;
+    return sprt;
+}
+#endif

+        sprite.draw(FILE_CACHE.getEntry(screen->archive1), towns[i] - 1, STSTATUS_data.towns[towns[i]].x + MAP_X(screen),
                     STSTATUS_data.towns[towns[i]].y + screen->scrollY + screen->top);

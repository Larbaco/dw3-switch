+    s32 sideLeft = 0;
+    s32 sideRight = 0;
+
+    s32 mapX = mapDrawScrollX(screen, &sideTop, &sideBottom, &sideLeft, &sideRight);
+#endif
 
     if (screen->hovering) {
         initSpriteDrawer(&sprite);
@@ -209,12 +283,12 @@ void STSTATUS_drawMapScreen(StatusMapScreen *screen) {

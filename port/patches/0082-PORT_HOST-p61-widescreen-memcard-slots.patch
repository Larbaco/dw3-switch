+        sprite.draw(FILE_CACHE.getEntry(FILE_GMCARD_SHEET << 16), 0x23, MCARD_CURSOR_X(menu->lerps[2].value, menu->lerps[3].value), menu->lerps[1].value + 0x12);
         sprite.setClutRow(0);
-        sprite.draw(FILE_CACHE.getEntry(FILE_GMCARD_SHEET << 16), 0x20, 0, menu->lerps[1].value + 0x10);
-        (*windows)->setPos(*windows, 0x15, menu->lerps[1].value + 0x18);
+        sprite.draw(MCARD_BAND(FILE_CACHE.getEntry(FILE_GMCARD_SHEET << 16), 0x20, MCARD_HEADER_SPLIT), 0x20, 0, menu->lerps[1].value + 0x10);

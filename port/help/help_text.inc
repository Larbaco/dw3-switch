"# menu: OBJETS, TRIER, CARTE, TECHNIQUES, STATUT, OPTIONS, RETOUR TITRE) and the\n"
"# port's own French lettering (tools/generate_pc_title_lettering.py). Screen words\n"
"# the port only has in English (crash panel, BUILDING, MOD 4X, Nearest, Lanczos2,\n"
"# FSR 1) stay in English between quotation marks, as the game shows them.\n"
"# Keys, qualifiers and {btn:..} {path:..} tokens are exactly those of en.txt.\n"
"\n"
"@format = 1\n"
"@book = help\n"
"@lang = fr\n"
"@status = draft, machine-drafted, needs native review\n"
"\n"
"# --------------------------------------------------- the screen's own words\n"
"help.ui.str.open = Ouvrir\n"
"help.ui.str.back = Retour\n"
"help.ui.str.scroll = Défiler\n"
"help.ui.str.pages = Pages\n"
"help.ui.str.page = Page\n"
"help.ui.str.unverified = (non vérifié)\n"
"help.ui.str.draft = (brouillon)\n"
"\n"
"# ---------------------------------------------------------------- setup\n"
"help.setup.title = Installation\n"
"help.setup.blurb = Ce qu'il faut et ce que fait le premier lancement.\n"
"help.setup.p.1 = Il vous faut une Switch avec Atmosphere et hbmenu, le .nro du portage pour la région de votre disque, et votre propre disque copié en paire BIN et CUE. Aucun fichier du jeu n'est fourni avec le portage, et un disque d'une autre région est refusé.\n"
"help.setup.li.1 @us = Disque US (SLUS-01436) : dw3-switch.nro. Dossier d'exécution {path:root}us/. Placez le BIN et le CUE dans {path:root}.\n"
"help.setup.li.2 @eu = Disque EU (SLES-03936) : dw3-switch-eu.nro. Dossier d'exécution {path:root}eu/. Placez le BIN et le CUE dans {path:root}eu/.\n"
"help.setup.p.2 = Le premier lancement lit le disque, extrait les données du jeu et affiche une barre de progression. Laissez-le terminer. Les lancements suivants vérifient les fichiers extraits et ne relisent pas le BIN.\n"
"help.setup.warn.1 = Ne supprimez et ne déplacez jamais les fichiers de sauvegarde pour forcer une nouvelle extraction. Copiez le dossier memcard avant de supprimer le dossier d'une région.\n"
"help.setup.note.1 = US et EU ont chacune leur dossier et leurs réglages.\n"
"\n"
"# ------------------------------------------------------------- controls\n"
"help.controls.title = Commandes\n"
"help.controls.blurb = Quel bouton fait quoi, dans le jeu et les menus.\n"
"help.controls.p.1 = Le jeu pense en boutons PlayStation. Par défaut, le portage utilise la disposition Nintendo : A valide et B annule. Avec Options, Commandes, Disposition boutons sur PlayStation, les boutons de droite suivent leur position, comme sur la manette d'origine. La colonne de droite indique le bouton qui produit chaque bouton PlayStation en ce moment, selon la disposition choisie.\n"
"help.controls.row.1 = Se déplacer | {btn:dpad}\n"
"help.controls.row.2 = Croix, valide | {btn:cross}\n"
"help.controls.row.3 = Rond, valide aussi dans Options | {btn:circle}\n"
"help.controls.row.4 = Triangle, retour dans Options | {btn:triangle}\n"
"help.controls.row.5 = Carré | {btn:square}\n"
"help.controls.row.6 = Start | {btn:start}\n"
"help.controls.row.7 = Select | {btn:select}\n"
"help.controls.row.8 = L1 et R1 | {btn:l1} et {btn:r1}\n"
"help.controls.row.9 = L2 et R2 | {btn:l2} et {btn:r2}\n"
"help.controls.row.10 = L3 et R3 | {btn:l3} et {btn:r3}\n"
"help.controls.h.1 = Menus\n"
"help.controls.li.1 = Sur l'écran titre, {btn:start} affiche les choix : Commencer, Options, Charger et Quitter. Haut et Bas déplacent le curseur, {btn:cross} valide.\n"
"help.controls.li.2 = Sur la carte, {btn:start} ouvre le menu du jeu. Il comporte une ligne OPTIONS et, en dernier, une ligne RETOUR TITRE.\n"
"help.controls.li.3 = Pendant une vidéo d'introduction, appuyez sur {btn:start} (ou maintenez-le) pour la passer.\n"
"help.controls.li.4 @pc = PC seulement : F4 active ou quitte le plein écran, Échap ferme la fenêtre.\n"
"help.controls.note.1 = Le rôle d'un bouton dépend de la scène où vous êtes. Les raccourcis du portage ont leur propre page.\n"
"\n"
"# -------------------------------------------------------------- hotkeys\n"
"help.hotkeys.title = Raccourcis\n"
"help.hotkeys.blurb = Les raccourcis que le portage ajoute au jeu.\n"
"help.hotkeys.row.1 = Avance rapide, activée ou non | {btn:r3}\n"
"help.hotkeys.row.2 = Redémarrer le jeu | {chord:restart}\n"
"help.hotkeys.row.3 = Options depuis l'écran titre | {btn:select}\n"
"help.hotkeys.row.4 = Options en combat | {btn:select}\n"
"help.hotkeys.row.5 = Vue de la carte, sur l'écran Carte | {btn:square}\n"
"help.hotkeys.row.6 !unv = Vue de la carte, depuis la marche | {btn:select}\n"
"help.hotkeys.row.7 = Changer de partenaire, panneau d'équipement | {btn:l2} et {btn:r2}\n"
"help.hotkeys.h.1 = Redémarrage\n"
"help.hotkeys.p.1 = La combinaison de redémarrage est inactive tant que vous n'activez pas Raccourci de reset dans Options. Maintenez les quatre boutons ensemble ; elle ne se déclenche qu'une fois par appui, relâchez donc les boutons avant de réessayer. Les emplacements de sauvegarde sont écrits d'abord, et si cela échoue, le redémarrage est annulé. La progression depuis votre dernière sauvegarde est perdue. La ligne RETOUR TITRE du menu de la carte effectue le même redémarrage après une question Oui ou Non.\n"
"help.hotkeys.h.2 = Options\n"
"help.hotkeys.p.2 = {btn:select} ouvre Options depuis l'écran titre seulement quand les choix sont affichés et qu'aucun bouton d'épaule ou de gâchette n'est maintenu. En combat, cela ne marche que lorsque le menu de commandes attend votre choix, jamais pendant les attaques ni dans les listes de techniques et d'objets. Le combat est entièrement figé tant qu'Options est ouvert.\n"
"help.hotkeys.h.3 = Changement de partenaire\n"
"help.hotkeys.p.3 = Dans Statut, panneau d'équipement, quand la liste des emplacements attend, {btn:l2} et {btn:r2} passent au partenaire précédent ou suivant. Il faut au moins deux partenaires.\n"
"\n"
"# ---------------------------------------------------------------- turbo\n"
"help.turbo.title = Turbo\n"
"help.turbo.blurb = Ce que l'avance rapide accélère, ou non.\n"
"help.turbo.p.1 = Appuyez sur {btn:r3} pour activer ou couper le turbo. Le jeu démarre toujours à vitesse normale. Relâchez le stick avant d'appuyer de nouveau.\n"
"help.turbo.p.2 = La vitesse choisie est la ligne Avance rapide d'Options : 2x, 3x, 4x ou OFF. 2x est la valeur par défaut. OFF désactive le bouton.\n"
"help.turbo.h.1 = Où cela marche\n"
"help.turbo.li.1 = Pleine vitesse : marche, textes, scènes, transitions et animations de combat sur la carte et en combat, ainsi que le rapport de combat.\n"
"help.turbo.li.2 = Environ 1,5x quand le turbo est actif : les menus ouverts sur la carte ou en combat, comme la liste du menu de la carte, Options et le menu de commandes du combat.\n"
"help.turbo.li.3 = Toujours vitesse normale : l'écran titre, les vidéos, les écrans de carte mémoire, le jeu de cartes, les écrans Statut, Objets et Carte du menu de la carte, et les boutiques.\n"
"help.turbo.note.1 = En turbo, la musique garde sa vitesse normale (Options, Son, Musique turbo : 1x, par défaut). Avec Rapide, la musique s'accélère avec le jeu. Les effets sonores déclenchés par l'action arrivent toujours plus vite. La vitesse réelle dépend de ce que la console parvient à suivre.\n"
"\n"
"# -------------------------------------------------------------- options\n"
"help.options.title = Les Options\n"
"help.options.blurb = Chaque ligne, ses valeurs et sa valeur par défaut.\n"
"help.options.p.1 = Options est une liste de groupes : Affichage, Son, Jouabilité, Menus, Commandes, Sauvegardes, Avancé, Aide et Pas à pas (Avancé seulement dans une version avec le menu de test). Haut et Bas choisissent, {btn:cross} ou {btn:circle} ouvre un groupe ou change une ligne, {btn:triangle} revient en arrière. Une ligne sous la liste explique la ligne choisie. Les changements s'appliquent aussitôt et sont enregistrés dans port_options.cfg, un seul fichier pour les deux régions et tous les profils. Chaque changement que ce portage apporte au jeu d'origine a sa ligne, et OFF est le jeu d'origine.\n"
"help.options.p.2 = Ouvrez-les depuis le menu de l'écran titre, depuis la ligne OPTIONS du menu de la carte, ou en combat avec {btn:select}.\n"
"help.options.h.1 = Affichage\n"
"help.options.li.1 = Écran large : ON ou OFF, ON par défaut. Environ 16:9 sur la carte, en combat et dans plusieurs menus. L'écran titre et les vidéos restent en 4:3. Carte plein écran : OFF ou ON, OFF par défaut. ON permet au bouton {btn:square} de l'écran Carte d'ouvrir une carte plein écran (voir Carte et mods). Le réglage s'applique aussitôt, même en jeu, et est enregistré. Résolution interne : 1x, 2x ou 3x, 1x par défaut. Dessine la 3D des combats avec autant de fois les pixels d'origine : bords plus lisses, plus de batterie (sur PC, toute l'image est agrandie). La console peut en offrir moins, en portable ou sur la TV. Rés. native en turbo : ON ou OFF, ON par défaut. Pendant l'avance rapide, le jeu dessine en 1x et saute les images de combat non affichées, puis revient à votre résolution.\n"
"help.options.li.2 = Filtre de carte : Nearest, Sharp bilinear, Lanczos2, FSR 1 ou Bilinear, FSR 1 par défaut. Le filtre d'image de la carte plein écran ; il s'applique à la prochaine ouverture de la carte. La carte s'affiche un instant en Nearest pendant que FSR 1 ou Lanczos2 se calcule en arrière-plan. {btn:l2} et {btn:r2} dans la vue le changent pour la session. Filtre de sortie : Nearest, Bilinear ou Sharp bilinear, Nearest par défaut. La façon d'étirer l'image à l'écran. Nearest garde des pixels durs ; Sharp bilinear les garde nets et n'adoucit que les jonctions, ce qui aide sur un téléviseur (en mode TV, l'étirement est de 4,5x) ; Bilinear rend flou. Il s'applique tout de suite. Pack de mod carte : ON ou OFF, ON par défaut. Utilise un pack d'agrandissement de carte installé pour la carte plein écran (voir Carte et mods) ; OFF montre la carte d'origine. Le réglage s'applique à la prochaine ouverture de la carte.\n"
"help.options.li.3 = Étiquette de version : ON ou OFF, ON par défaut. Affiche la version du portage dans le coin de l'écran titre. Les écrans Options l'affichent toujours.\n"
"help.options.h.2 = Son\n"
"help.options.li.4 = Volume musique et Volume effets : OFF, ou de 1 à 10, 10 par défaut, ce qui correspond au mixage d'origine. Gauche et Droite changent la valeur ; {btn:cross} l'augmente et repasse de 10 à 0. L'écran joue les sons de menu du jeu pour que vous entendiez le changement. Musique turbo : 1x ou Rapide, 1x par défaut. Avec 1x, la musique garde sa vitesse normale pendant l'avance rapide ; Rapide l'accélère avec le jeu.\n"
"help.options.h.3 = Jouabilité\n"
"help.options.li.5 = Avance rapide : 2x, 3x, 4x ou OFF, 2x par défaut. La vitesse que {btn:r3} active.\n"
"help.options.li.6 = Taux de combats : OFF, 0.5x, 1x, 1.5x ou 2x, 1x par défaut. Combats aléatoires seulement ; les combats de l'histoire ont toujours lieu.\n"
"help.options.li.7 = Vitesse du texte : Normal, Rapide ou Instantané, Normal par défaut, c'est le réglage d'origine.\n"
"help.options.li.8 = Curseur de combat : OFF, Commande ou Commande+Tech, OFF par défaut. Le menu de commandes du combat, et avec Commande+Tech la liste des techniques, s'ouvre sur votre dernier choix. Un changement s'applique dès le tour suivant.\n"
"help.options.h.4 = Menus\n"
"help.options.li.9 = Équiper depuis Objets : ON ou OFF, ON par défaut. {btn:cross} sur une arme, une armure ou un accessoire dans le menu Objets l'équipe. OFF, c'est l'original : rien ne se passe.\n"
"help.options.li.10 = Rester sur la liste : ON ou OFF, ON par défaut. Après l'équipement, on revient aussitôt à la liste des emplacements, curseur conservé. OFF rend les longs fondus.\n"
"help.options.li.11 = Tout le sac : ON ou OFF, ON par défaut. {btn:square} affiche tout le sac dans la liste d'équipement, et un objet peut passer d'un Digimon à l'autre. OFF, c'est l'original.\n"
"help.options.li.12 = Rester après usage : ON ou OFF, ON par défaut. Après l'usage d'un objet, le choix du partenaire reste ouvert pour le suivant. OFF revient à la liste.\n"
"help.options.li.13 = Autre partenaire : ON ou OFF, ON par défaut. {btn:l2} et {btn:r2} changent de Digimon sur le panneau d'équipement. OFF, c'est l'original.\n"
"help.options.li.14 = Sortie rapide du menu : ON ou OFF, ON par défaut. Quitter les écrans du menu de la carte (Objets, Carte, Statut et les autres) pour le terrain saute le fondu en blocs et revient aussitôt. Le jeu continue exactement comme si le fondu avait eu lieu : les horloges et les nombres aléatoires avancent pareil. OFF joue le fondu d'origine.\n"
"help.options.h.5 = Commandes\n"
"help.options.li.15 = Disposition boutons : PlayStation ou Nintendo, Nintendo par défaut. Avec Nintendo, A valide et B revient en arrière ; le bouton secondaire (Rond) passe sur X. PlayStation garde les boutons selon leur position, comme sur la manette d'origine. Start, Select, les gâchettes et les sticks ne changent pas. Le réglage s'applique aussitôt et est enregistré. Les réglages enregistrés par une version plus ancienne ont été passés une fois sur Nintendo ; remettez-le ici et il reste. Réinitialiser remet la disposition Nintendo.\n"
"help.options.li.16 = Boutons carte : ouvre un écran avec les boutons de la carte plein écran : ouvrir, zoom arrière, zoom avant, centrer sur votre zone, filtre précédent et suivant, ouvrir depuis le terrain. Gauche et Droite choisissent un bouton ; un bouton déjà pris par une autre action est échangé avec elle. Réinit. boutons carte remet les réglages par défaut. Le réglage s'applique à la prochaine ouverture de la carte.\n"
"help.options.li.17 = Raccourci de reset : ON ou OFF, OFF par défaut. Active la combinaison de redémarrage. Cette ligne vient de Jouabilité ; votre réglage est conservé.\n"
"help.options.li.18 = Symboles Switch (Switch seulement) : ON ou OFF, ON par défaut. ON dessine le bouton Switch, A, B, X ou Y, qui produit vraiment chaque invite, et suit la disposition et la personnalisation des boutons. OFF garde les icônes d'origine. Le réglage s'applique aussitôt et est enregistré.\n"
"help.options.h.6 = Sauvegardes\n"
"help.options.li.19 = Sauvegarde auto : OFF ou Chaque zone, OFF par défaut. Voir la page Sauvegardes.\n"
"help.options.li.20 = Région au démarrage (version combinée seulement) : Demander, US ou EU, Demander par défaut. Choisit le jeu qui démarre. Cette ligne vient de Jouabilité.\n"
"help.options.li.21 = Saves partagées (expérimental) : ON ou OFF, OFF par défaut. US et EU partagent une seule réserve de sauvegardes par profil. L'activer pose d'abord la question, curseur sur Non ; copiez vos sauvegardes avant de répondre Oui. Le réglage s'applique au prochain démarrage et ne se change que depuis l'écran titre.\n"
"help.options.h.7 = Avancé\n"
"help.options.li.22 = Balayage des zones : OFF, Lancer ou Recommencer, OFF par défaut. Outil de test : au prochain démarrage, le jeu parcourt tous les stages tout seul, sans personne à la manette. Lancer reprend aussi un balayage interrompu par un plantage ; Recommencer efface d'abord la progression puis affiche Lancer. Il tourne dans la région qui démarre, et son journal nomme cette région. L'activer pose d'abord la question. Écran titre seulement.\n"
"help.options.li.23 = Images par stage : de 30 à 3600, 90 par défaut. Gauche et Droite changent de 30, {btn:l1} et {btn:r1} de 300. Écran titre seulement.\n"
"help.options.note.1 = Sur la carte et en combat, Écran large est grisé et indique qu'il est verrouillé. La carte est mise en page au chargement d'une zone : changez ce réglage depuis l'écran titre.\n"
"help.options.note.2 = Sur le disque EU, les lignes et les textes s'affichent dans la langue du jeu.\n"
"help.options.note.3 = En jeu, Saves partagées et les lignes Avancé sont aussi grisées, car elles sont lues au démarrage du jeu.\n"
"\n"
"# ---------------------------------------------------------------- saves\n"
"help.saves.title = Sauvegardes\n"
"help.saves.blurb = Emplacements, sauvegarde auto, profils et imports.\n"
"help.saves.p.1 = La sauvegarde est manuelle, comme dans le jeu d'origine. Le portage écrit les emplacements modifiés à des moments sûrs et quand vous appuyez sur HOME ou mettez la console en veille. Il ne sauvegarde jamais à votre place, sauf si Sauvegarde auto est activée ; il écrit alors son propre fichier.\n"
"help.saves.h.1 = Emplacements et fichiers\n"
"help.saves.li.1 = Deux emplacements : save0.bin et save1.bin, plus autosave.bin une fois la sauvegarde auto exécutée.\n"
"help.saves.li.2 = Ils se trouvent dans {path:memcard}\n"
"help.saves.li.3 @switch !unv = Les sauvegardes appartiennent au profil Switch qui joue. Le profil vient du sélecteur du lanceur, sinon de l'unique utilisateur de la console, sinon du sélecteur système. Si vous annulez le sélecteur système, le jeu ne démarre pas.\n"
"help.saves.li.4 @switch !unv = Les sauvegardes des anciennes préversions (le dossier memcard us ou eu sans profil) sont copiées dans le dossier de chaque profil au premier démarrage de ce profil. Les originaux restent en place. Les sauvegardes suivantes d'un profil n'apparaissent pas dans un autre.\n"
"help.saves.li.5 = US et EU ont leurs propres sauvegardes. Les réglages sont communs.\n"
"help.saves.li.6 = Tous les réglages sont dans un seul fichier, port_options.cfg dans {path:root}, pour les deux régions et tous les profils.\n"
"help.saves.li.7 = Au premier démarrage après la mise à jour, les anciens fichiers de réglages us et eu y ont été fusionnés, la dernière région jouée en premier. Les anciens fichiers ont été copiés en port_options.cfg.us.bak et .eu.bak dans le même dossier, puis supprimés. Pour revenir en arrière, copiez un .bak dans le dossier de la région sous le nom port_options.cfg.\n"
"help.saves.h.2 = Sauvegarde auto\n"
"help.saves.p.2 = Avec Sauvegarde auto sur Chaque zone, le premier moment calme dans chaque nouvelle zone de la carte écrit la partie dans autosave.bin. Vos deux emplacements ne sont jamais touchés, et il n'y a qu'une seule sauvegarde auto : une nouvelle partie la remplace dès son premier changement de zone.\n"
"help.saves.li.8 = Quand une sauvegarde auto existe, l'écran titre affiche Continuer, qui la charge aussitôt, et Charger, qui ouvre la liste des emplacements. Sans sauvegarde auto, il n'y a pas de Continuer.\n"
"help.saves.li.9 = Elle ne s'exécute pas pendant les événements, les menus, les dialogues, les escalades, les bannières de zone, les fondus ou le début d'un combat, ni avant que l'histoire soit assez avancée pour ouvrir le menu de la carte, ni sur une carte que la liste des sauvegardes ne connaît pas. Un combat qui ramène dans la même zone ne compte pas.\n"
"help.saves.li.10 = Une écriture ratée est consignée dans le journal et le jeu continue avec l'ancienne sauvegarde auto. Il n'y a pas encore de message à l'écran.\n"
"help.saves.h.3 = Importer depuis l'autre région\n"
"help.saves.p.3 !unv = Si une région n'a aucune sauvegarde, la version copie une fois la sauvegarde de l'autre région, convertie, dans son propre emplacement. L'original n'est jamais modifié, la copie n'a lieu que si la région n'a aucun fichier de sauvegarde, et elle ne recommence pas si vous supprimez la copie. Les sauvegardes faites ensuite restent dans leur région. Une sauvegarde du chapitre supplémentaire EU n'est pas importée vers US.\n"
"help.saves.h.4 = Copies de secours\n"
"help.saves.p.4 = Copiez le dossier memcard de la carte SD pour garder une copie de secours. Faites-le avant de supprimer le dossier d'une région.\n"
"\n"
"# --------------------------------------------------------- widescreen\n"
"help.widescreen.title = Écran large\n"
"help.widescreen.blurb = L'image large et là où elle s'applique.\n"
"help.widescreen.p.1 = Écran large est sur ON par défaut. Les scènes prises en charge, la carte, les combats et plusieurs menus, utilisent de larges zones latérales pour environ 16:9. L'écran titre et les vidéos restent en 4:3. L'image de 240 lignes du disque EU suit la même règle de format.\n"
"help.widescreen.p.2 = Ce réglage se change en direct dans Options, mais il est verrouillé pendant une partie, car les cartes sont mises en page au chargement d'une zone. Changez-le depuis l'écran titre.\n"
"help.widescreen.note.1 = La vue de la carte exige Écran large sur ON.\n"
"\n"
"# ------------------------------------------------------------ map & mods\n"
"help.map.title = Carte et mods\n"
"help.map.blurb = La carte en plein écran et le pack de carte facultatif.\n"
"help.map.h.1 = Vue de la carte\n"
"help.map.p.1 !unv = Ouvrez le menu de la carte avec {btn:start}, choisissez Carte, puis appuyez sur {btn:square}. La carte remplit l'image large et montre les villes et zones découvertes. Écran large doit être sur ON, Options, Affichage, Carte plein écran aussi.\n"
"help.map.li.1 = {btn:dpad} déplace le curseur, qui démarre sur votre zone actuelle. Sur un lieu, la boîte de nom du jeu apparaît.\n"
"help.map.li.2 = Le stick droit zoome en douceur ; {btn:l1} et {btn:r1} zooment par paliers.\n"
"help.map.li.3 = {btn:l2} et {btn:r2} changent le filtre d'agrandissement. \"FSR 1\" est la valeur par défaut (Options, Affichage, Filtre de carte). La carte s'affiche en \"Nearest\" pendant que \"FSR 1\" et \"Lanczos2\" se calculent en arrière-plan, et l'écran affiche \"BUILDING\" pendant ce temps.\n"
"help.map.li.4 = {btn:circle} masque le texte et la boîte de nom. {btn:triangle} ferme la vue. {btn:r3} ne fait rien ici.\n"
"help.map.li.5 !unv = Sur la carte, {btn:select} ouvre cette vue aussitôt et fige la carte, à partir du point 4 de l'histoire. Écran large et Carte plein écran doivent être sur ON. Triangle ferme la vue et vous rend la carte.\n"
"help.map.h.2 = Pack d'agrandissement de la carte\n"
"help.map.p.2 !unv = Un pack remplace l'image de la carte par une version plus nette. Aucun n'est fourni avec le portage, car il est créé à partir de votre propre disque. Un outil PC du dépôt (tools/mods/extract_map_assets.py) extrait la carte de base, lance un agrandisseur que vous installez, et écrit un dossier à copier dans {path:root}mods/<pack>/ sur la carte SD.\n"
"help.map.li.6 !unv = Il n'y a aucune ligne dans Options. Le pack est utilisé dès qu'un pack valide pour votre région se trouve dans le dossier mods. La vue affiche alors \"MOD 4X\".\n"
"help.map.li.7 !unv = Un fichier de mauvaise taille ou un pack absent fait revenir la vue à la carte d'origine. Le jeu n'a jamais besoin d'un pack pour démarrer.\n"
"help.map.li.8 !unv = Pour revenir à la carte d'origine, renommez ou supprimez le dossier du pack, ou mettez Options, Affichage, Pack de mod carte sur OFF.\n"
"help.map.li.9 !unv = Avec un pack, {btn:l2} et {btn:r2} ne changent que le filtre, net ou doux.\n"
"\n"
"# ---------------------------------------------------------- logs & bugs\n"
"help.logs.title = Journaux, bugs\n"
"help.logs.blurb = Où sont les journaux et quoi envoyer.\n"
"help.logs.h.1 = Journaux\n"
"help.logs.p.1 = Le portage écrit dw3.log dans {path:root}. Il garde les cinq derniers lancements : dw3.log est le plus récent, puis dw3.1.log jusqu'à dw3.4.log. Chaque lancement écrit une ligne dw3-log: rotated qui indique si l'ancien journal a été renommé, copié ou perdu.\n"
"help.logs.p.2 = Les fonctions consignent leurs décisions, une fois par événement, avec un préfixe comme dw3-port-options: ou dw3-map:, si bien qu'un rapport accompagné des journaux montre en général ce qui s'est passé.\n"
"help.logs.h.2 = Après un plantage\n"
"help.logs.p.3 = Un plantage écrit crash_report.txt à côté des journaux. Au lancement suivant, un panneau affiche \"The last run crashed.\" avec la version, la raison et le chemin du rapport. Il attend jusqu'à 60 secondes, ou que vous appuyiez sur A, B ou Plus, et n'apparaît qu'une fois par plantage. Le rapport est ensuite déplacé vers crash_report_prev.txt.\n"
"help.logs.warn.1 = Un seul rapport précédent est conservé. Si le jeu replante, copiez d'abord crash_report.txt, crash_report_prev.txt et tous les dw3*.log depuis la carte SD.\n"
"help.logs.h.3 = Signaler un bogue\n"
"help.logs.li.1 = Ouvrez un ticket sur le suivi GitHub du projet (Larbaco/dw3-switch). Cherchez d'abord, et complétez un ticket existant s'il correspond.\n"
"help.logs.li.2 = Indiquez la version ({build:version}), la région ({build:region}), la console et le mode, des étapes numérotées, ce que vous attendiez, ce qui s'est passé et à quelle fréquence.\n"
"help.logs.li.3 = Joignez tous les journaux et tout rapport de plantage. Soyez précis : la carte, le menu, le Digimon, la technique.\n"
"help.logs.warn.2 = Ne joignez jamais d'image de disque, de fichiers BIOS ni de données extraites du jeu.\n"
"\n"
"# ------------------------------------------------------------------ faq\n"
"help.faq.title = FAQ\n"
"help.faq.blurb = Réponses courtes aux questions fréquentes.\n"
"help.faq.q.1 = Écran large est grisé dans le jeu.\n"
"help.faq.a.1 = Il est verrouillé pendant une partie. Revenez à l'écran titre (menu de la carte, dernière ligne) et changez-le là.\n"
"help.faq.q.2 = {btn:r3} n'accélère rien.\n"
"help.faq.a.2 = Vérifiez que Avance rapide n'est pas sur OFF. Le turbo ne marche que sur la carte, en combat et sur le rapport de combat ; l'écran titre, les vidéos, le jeu de cartes et les écrans Statut, Objets et Carte restent à vitesse normale.\n"
"help.faq.q.3 = La combinaison de redémarrage ne fait rien.\n"
"help.faq.a.3 = Raccourci de reset est sur OFF par défaut. Activez-le dans Options, Commandes. Relâchez les boutons avant de réessayer.\n"
"help.faq.q.4 = {btn:select} n'ouvre pas Options.\n"
"help.faq.a.4 = Sur l'écran titre, les choix doivent être affichés, et en combat le menu de commandes doit attendre. Le bouton est ignoré tant qu'un bouton d'épaule ou de gâchette est maintenu.\n"
"help.faq.q.5 = L'écran titre affiche Continuer et Charger.\n"
"help.faq.a.5 = Continuer charge aussitôt la sauvegarde auto. Charger ouvre la liste des emplacements. L'écran titre n'affiche Continuer que lorsqu'une sauvegarde auto existe.\n"
"help.faq.q.6 = La sauvegarde auto n'a rien écrit.\n"
"help.faq.a.6 = Elle écrit au premier moment calme d'une nouvelle zone. Elle attend la fin des événements, des menus et des combats, ne s'exécute pas au début de l'histoire, et une écriture ratée est seulement consignée. Vérifiez Options, Sauvegardes.\n"
"help.faq.q.7 = Mes sauvegardes de l'autre région sont absentes.\n"
"help.faq.a.7 = Les deux régions ont des sauvegardes séparées. La seule copie est un import unique vers une région qui n'a aucune sauvegarde.\n"
"help.faq.q.8 = Le jeu s'est fermé quand j'ai annulé le choix du profil.\n"
"help.faq.a.8 @switch !unv = C'est voulu : le jeu ne démarre qu'avec un profil choisi.\n"
"help.faq.q.9 = Quitter n'a pas quitté le jeu.\n"
"help.faq.a.9 = Quitter écrit d'abord vos emplacements. Si cela échoue, la sortie est annulée pour ne perdre aucune progression. Réessayez, et envoyez le journal si cela se répète.\n"
"help.faq.q.10 = Le portage overclocke-t-il la console ?\n"
"help.faq.a.10 = Non. Il laisse les fréquences du CPU et du GPU là où la console les a réglées.\n"
"help.faq.q.11 = Où sont les problèmes connus ?\n"
"help.faq.a.11 = Ils changent à chaque préversion, ils ne sont donc pas recopiés ici. Lisez les notes de version et les tickets ouverts sur la page GitHub du projet.\n";
static const char help_text_de[] =
"# DW3NX technical help, German text (P6.30).\n"
"# MACHINE-DRAFTED, NEEDS NATIVE REVIEW. Written by an AI agent from en.txt; the\n"
"# owner approved the English and cannot check the other languages\n"
"# (docs/P6.30_HELP.md section 12). Terms follow the EU disc's own words (field\n"
"# menu: ITEMS, SORTIEREN, KARTE, TECHNIK, STATUS, OPTIONEN, TITELBILD) and the\n"
"# port's own German lettering (tools/generate_pc_title_lettering.py), which\n"
"# addresses the player as \"du\". Screen words the port only has in English (crash\n"
"# panel, BUILDING, MOD 4X, Nearest, Lanczos2, FSR 1) stay in English between\n"
"# quotation marks, as the game shows them.\n"
"# Keys, qualifiers and {btn:..} {path:..} tokens are exactly those of en.txt.\n"
"\n"
